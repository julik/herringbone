#!/usr/bin/env ruby
# frozen_string_literal: true

# Usage:
#   herringbone cat FILE [N]              print rows as JSON lines (optionally only the first N)
#   herringbone inspect FILE [--pages]          print the schema, row groups, column chunks (and every
#                                               page header); same as --format=text
#   herringbone inspect FILE --format=json      print all of it as JSON
#   herringbone inspect FILE --format=html      write a self-contained HTML page showing the file's layout
#                                               and open it in the browser (printed when stdout is redirected)
#   add --verify-checksums to any inspect form to read page bodies and check their CRCs
#   herringbone combine INPUT... --output=FILE  concatenate files with the same schema, copying their
#                                               row groups (to stdout when it is redirected and
#                                               --output is not given); --schema=union fills fields an
#                                               input lacks with nulls, --schema=intersect keeps only
#                                               the fields all inputs have, --compression=CODEC sets
#                                               the codec of the chunks that are encoded again
# `inspect` reads only the footer, page headers and page indexes: no values are decompressed.
#
# Encrypted files: both commands take --key=KEY (a key matched by its fingerprint id, or used for
# the footer when it is the only one), --key=KEY_ID=KEY, --footer-key=KEY and
# --column-key=PATH=KEY (all repeatable but --footer-key), and --aad-prefix=PREFIX. KEY is hex, or
# base64:..., or raw:... for the bytes as typed (a 16, 24 or 32-character String that is not
# valid hex is taken as is too). Keys that are needed but not given are asked for on stdin
# (without echo in a terminal; an empty answer skips the key), unless --no-prompt is given.
# `combine` takes the same flags for its inputs, and encrypts the output like the encrypted inputs;
# --encrypt-key=KEY encrypts it with that key instead, and --plaintext not at all.
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "herringbone"
require "json"
%w[zstd-ruby brotli snappy xxhash].each do |lib|
  require lib
rescue LoadError
end
require "tmpdir"
require "io/console"

def jsonable(v)
  case v
  when Hash then v.to_h { |k, x| [k.to_s, jsonable(x)] }
  when Array then v.map { |x| jsonable(x) }
  when String then v.encoding == Encoding::BINARY && !v.ascii_only? ? v.unpack1("H*") : v
  when Float then v.finite? ? v : v.to_s
  when Time then v.iso8601(9)
  when Date then v.iso8601
  when Integer, true, false, nil then v
  else v.to_s
  end
end

# Opens a file with the platform's default application
# @return [Boolean] whether the opener could be started
def open_with_default_app(path)
  command = case RbConfig::CONFIG["host_os"]
  when /darwin/ then ["open", path]
  when /mswin|mingw|cygwin/ then ["cmd", "/c", "start", "", path]
  else ["xdg-open", path]
  end
  !!system(*command, out: File::NULL, err: File::NULL, exception: false)
end

# A key as given on the command line or at the prompt: hex, base64:..., raw:..., or the bytes as
# typed when they are not valid hex but have the size of a key
# @return [String] the key
# @raise [ArgumentError] when it is none of those, or not 16, 24 or 32 bytes long
def parse_key(text, what)
  text = text.strip
  bytes = if text.start_with?("base64:")
    text.delete_prefix("base64:").unpack1("m0")
  elsif text.start_with?("raw:")
    text.delete_prefix("raw:")
  elsif text.match?(/\A(\h\h)+\z/) && Herringbone::Encryption::KEY_SIZES.include?(text.size / 2)
    [text].pack("H*")
  else
    text
  end
  Herringbone::Encryption.check_key!(bytes, what)
end

# Asks for a key on stderr and reads it from stdin, without echo when stdin is a terminal
# @return [String, nil] the key, nil when the answer is empty or stdin is exhausted
def ask_key(metadata, owner)
  what = (owner == :footer) ? "the footer" : "column #{owner}"
  $stderr.print "Key for #{what}#{" (key metadata #{metadata.inspect})" if metadata}, hex: "
  line = $stdin.tty? ? $stdin.noecho(&:gets) : $stdin.gets
  $stderr.puts
  return nil if line.nil? || line.strip.empty?
  parse_key(line, "the key for #{what}")
rescue ArgumentError => e
  raise unless $stdin.tty?
  warn "herringbone: #{e.message}"
  retry
end

# The decryption: option from the key flags
# @return [Hash{Symbol => Object}]
def decryption_from(key_flags, prompt)
  by_metadata = {}
  plain = []
  decryption = {columns: {}}
  key_flags.each do |flag|
    name, value = flag.split("=", 2)
    case name
    when "--footer-key" then decryption[:footer_key] = parse_key(value.to_s, "--footer-key")
    when "--aad-prefix" then decryption[:aad_prefix] = value.to_s
    when "--key"
      target, key = value.to_s.split("=", 2)
      if key.nil? || value.start_with?("base64:", "raw:")
        plain << Herringbone::Key.new(parse_key(value.to_s, "--key"))
        by_metadata[plain.last.id] = plain.last.bytes
      else
        by_metadata[target] = parse_key(key, "--key=#{target}")
      end
    when "--column-key"
      target, key = value.to_s.split("=", 2)
      raise ArgumentError, "--column-key expects --column-key=PATH=KEY" unless key
      decryption[:columns][target] = parse_key(key, "--column-key=#{target}")
    end
  end
  decryption[:footer_key] ||= plain.first.bytes if plain.size == 1
  # combine reads a footer more than once, and its inputs may share keys
  asked = {}
  decryption[:keys] = lambda do |metadata, owner|
    by_metadata.fetch(metadata) do
      next unless prompt
      asked.key?([metadata, owner]) ? asked[[metadata, owner]] : (asked[[metadata, owner]] = ask_key(metadata, owner))
    end
  end
  decryption
end

USAGE = "usage: herringbone cat FILE [N] [KEY OPTIONS]\n" \
  "       herringbone inspect FILE [--format=text|json|html] [--pages] [--verify-checksums] [KEY OPTIONS]\n" \
  "       (--pages only with --format=text)\n" \
  "       herringbone combine INPUT... [--output=FILE] [--schema=union|intersect] [--compression=CODEC]\n" \
  "       [--encrypt-key=KEY | --plaintext] [KEY OPTIONS]\n" \
  "key options, for encrypted files: --key=KEY --key=KEY_ID=KEY --footer-key=KEY --column-key=PATH=KEY\n" \
  "       --aad-prefix=PREFIX --no-prompt (KEY is hex, base64:... or raw:...)"

KEY_FLAGS = %w[--footer-key --column-key --key --aad-prefix].freeze

command, *rest = ARGV
flags, args = rest.partition { |a| a.start_with?("--") }
key_flags, flags = flags.partition { |f| KEY_FLAGS.include?(f.split("=", 2).first) }
prompt = !flags.delete("--no-prompt")
path, limit = args
valid = case command
when "cat" then flags.empty? && path && (limit.nil? || limit.match?(/\A\d+\z/))
when "inspect"
  format_flags, other_flags = flags.partition { |f| f.start_with?("--format=") }
  format = format_flags.empty? ? "text" : format_flags.first.delete_prefix("--format=")
  path && limit.nil? && format_flags.size <= 1 && %w[text json html].include?(format) &&
    (other_flags - %w[--pages --verify-checksums]).empty? &&
    (format == "text" || !other_flags.include?("--pages"))
when "combine"
  options, other_flags = flags.partition { |f| f.start_with?("--output=", "--compression=", "--encrypt-key=", "--schema=") }
  output_path = options.find { |f| f.start_with?("--output=") }&.delete_prefix("--output=")
  schema_mode = options.find { |f| f.start_with?("--schema=") }&.delete_prefix("--schema=")
  !args.empty? && options.map { |f| f.split("=", 2).first }.uniq.size == options.size &&
    (schema_mode.nil? || %w[union intersect].include?(schema_mode)) &&
    (other_flags - %w[--plaintext]).empty? &&
    !(other_flags.include?("--plaintext") && options.any? { |f| f.start_with?("--encrypt-key=") }) &&
    (output_path ? !output_path.empty? : !$stdout.tty?)
end
unless valid
  warn USAGE
  exit 1
end

# Writes the inputs into one file, removing the output again when that fails
# @return [Herringbone::Combiner::Report]
def combine(paths, output_path, flags, options, decryption)
  if output_path && paths.any? { |p| File.expand_path(p) == File.expand_path(output_path) || (File.exist?(output_path) && File.identical?(p, output_path)) }
    raise ArgumentError, "#{output_path} is one of the inputs"
  end
  writer_options = {}
  schema = nil
  options.each do |option|
    name, value = option.split("=", 2)
    case name
    when "--compression" then writer_options[:compression] = value.to_sym
    when "--encrypt-key" then writer_options[:encryption] = Herringbone::Key.new(parse_key(value, "--encrypt-key"))
    when "--schema" then schema = value.to_sym
    end
  end
  writer_options[:encryption] = false if flags.include?("--plaintext")
  inputs = paths.map { |p| File.open(p, "rb") }
  output = output_path ? File.open(output_path, "wb") : $stdout.binmode
  begin
    Herringbone.combine(inputs, output, schema: schema, decryption: decryption, **writer_options)
  rescue Exception # standard:disable Lint/RescueException
    # A file without its footer is of no use to anyone
    if output_path
      output.close
      File.delete(output_path)
    end
    raise
  ensure
    output.close if output_path && !output.closed?
  end
ensure
  inputs&.each(&:close)
end

# Parquet, file and key errors are reported in one line, without a backtrace
begin
  decryption = decryption_from(key_flags, prompt)
  if command == "combine"
    report = combine(args, output_path, other_flags, options, decryption)
    copied, rewritten = report.row_groups.values_at(:copied, :rewritten)
    warn "herringbone: #{report.rows} rows, #{copied} row groups copied, #{rewritten} encoded again"
    exit
  end
  File.open(path, "rb") do |io|
    if command == "cat"
      n = limit&.to_i
      Herringbone::Reader.new(io, decryption: decryption).each_row(limit: n) { |row| puts JSON.generate(jsonable(row)) }
    else
      inspector = Herringbone::Inspector.new(io, decryption: decryption)
      inspector.verify_checksums if flags.include?("--verify-checksums")
      case format
      when "json"
        puts JSON.pretty_generate(inspector.to_h)
      when "html"
        if $stdout.tty?
          html_path = File.join(Dir.tmpdir, "#{File.basename(path, ".*")}-#{Process.pid}.html")
          File.binwrite(html_path, inspector.to_html)
          puts html_path
          warn "herringbone: could not open the page, open #{html_path} in a browser" unless open_with_default_app(html_path)
        else
          $stdout.write(inspector.to_html)
        end
      when "text"
        puts inspector.report(pages: flags.include?("--pages"))
      end
    end
  end
rescue Herringbone::Error, SystemCallError, ArgumentError => e
  warn "herringbone: #{e.message}"
  warn "herringbone: give keys with --footer-key=KEY, --column-key=PATH=KEY or --key=KEY_METADATA=KEY" if e.is_a?(Herringbone::DecryptionError)
  warn "herringbone: give --encrypt-key=KEY to encrypt the output, or --plaintext" if e.message.include?("Pass encryption: for the output")
  if e.is_a?(Herringbone::IncompatibleSchema) && command == "combine"
    warn "herringbone: give --schema=union to fill the fields an input lacks with nulls, or --schema=intersect to keep " \
      "only the fields all inputs have"
  end
  exit 1
end
