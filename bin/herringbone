#!/usr/bin/env ruby
# frozen_string_literal: true

# Usage:
#   herringbone cat FILE [N]              print rows as JSON lines (optionally only the first N)
#   herringbone inspect FILE [--pages]    print the schema, row groups, column chunks (and every page header)
#   herringbone inspect FILE --json       print all of it as JSON
#   herringbone inspect FILE --html       print a self-contained HTML page showing the file's layout
#   add --verify-checksums to any inspect form to read page bodies and check their CRCs
# `inspect` reads only the footer, page headers and page indexes: no values are decompressed.
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "herringbone"
require "json"

def jsonable(v)
  case v
  when Hash then v.to_h { |k, x| [k.to_s, jsonable(x)] }
  when Array then v.map { |x| jsonable(x) }
  when String then v.encoding == Encoding::BINARY && !v.ascii_only? ? v.unpack1("H*") : v
  when Float then v.finite? ? v : v.to_s
  when Time then v.iso8601(9)
  when Date then v.iso8601
  when Integer, true, false, nil then v
  else v.to_s
  end
end

USAGE = "usage: herringbone cat FILE [N]\n" \
  "       herringbone inspect FILE [--pages | --json | --html] [--verify-checksums]"

command, *rest = ARGV
flags, args = rest.partition { |a| a.start_with?("--") }
path, limit = args
valid = case command
when "cat" then flags.empty? && path && (limit.nil? || limit.match?(/\A\d+\z/))
when "inspect"
  formats = flags & %w[--pages --json --html]
  path && limit.nil? && (flags - %w[--pages --json --html --verify-checksums]).empty? && formats.size <= 1
end
unless valid
  warn USAGE
  exit 1
end

# Parquet and file errors are reported in one line, without a backtrace
begin
  File.open(path, "rb") do |io|
    if command == "cat"
      n = limit&.to_i
      Herringbone::Reader.new(io).each_row(limit: n) { |row| puts JSON.generate(jsonable(row)) }
    else
      inspector = Herringbone::Inspector.new(io)
      inspector.verify_checksums if flags.include?("--verify-checksums")
      if flags.include?("--json")
        puts JSON.pretty_generate(inspector.to_h)
      elsif flags.include?("--html")
        $stdout.write(inspector.to_html)
      else
        puts inspector.report(pages: flags.include?("--pages"))
      end
    end
  end
rescue Herringbone::Error, SystemCallError => e
  warn "herringbone: #{e.message}"
  exit 1
end
